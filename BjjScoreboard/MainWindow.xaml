<Window x:Class="BjjScoreboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BjjScoreboard"
        Title="Jiu-Jitsu Multi Scoreboard" Height="720" Width="1200" Background="#111E2E"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="45" />
            <RowDefinition Height="*" />
            <RowDefinition Height="130" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0">
            <RadioButton Content="BJJ (Борьба)" IsChecked="{Binding IsBjjActive, Mode=OneWay}" Command="{Binding SwitchDisciplineCmd}" CommandParameter="BJJ" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,20,0" VerticalAlignment="Center"/>
            <RadioButton Content="JJIF Fighting (Файтинг)" IsChecked="{Binding IsFightingActive, Mode=OneWay}" Command="{Binding SwitchDisciplineCmd}" CommandParameter="FIGHTING" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>

        <ContentControl Grid.Row="1" Content="{Binding}">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentDiscipline}" Value="BJJ">
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <local:BjjView/>
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CurrentDiscipline}" Value="FIGHTING">
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <local:FightingView/>
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>

        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <ComboBox ItemsSource="{Binding Genders}" SelectedItem="{Binding SelectedGender}" Focusable="False" FontSize="18" Width="130" Margin="0,0,10,0"/>
                    <TextBox x:Name="WeightBox" Text="{Binding WeightInput, UpdateSourceTrigger=PropertyChanged}" Foreground="White" FontSize="20" FontWeight="Bold" Background="#172637" BorderBrush="#393939" Width="60" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    <TextBlock Text=" кг" Foreground="White" FontSize="20" VerticalAlignment="Center" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Сброс матча" Command="{Binding ResetCommand}" Focusable="False" Width="110" Height="35" Background="#393939" Foreground="White" FontWeight="Bold"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,40,0" HorizontalAlignment="Right">
                <TextBlock Text="Время боя (мин):" Foreground="#8A99AD" FontSize="14" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="-" Command="{Binding ModifyMatchDurationCmd}" CommandParameter="-1" Focusable="False" Width="30" Height="35" FontWeight="Bold" FontSize="18"/>
                    <TextBlock Text="{Binding MatchDurationMinutes}" Foreground="White" FontSize="24" Width="50" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                    <Button Content="+" Command="{Binding ModifyMatchDurationCmd}" CommandParameter="1" Focusable="False" Width="30" Height="35" FontWeight="Bold" FontSize="18"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Grid.Column="2" Text="{Binding TimeDisplay}" Foreground="{Binding TimerColor}" FontSize="96" FontWeight="Light" VerticalAlignment="Center" HorizontalAlignment="Right" FontFamily="Consolas"/>
        </Grid>
    </Grid>
</Window>