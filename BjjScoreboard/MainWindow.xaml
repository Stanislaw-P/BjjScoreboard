<Window x:Class="BjjScoreboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BJJ Scoreboard" Height="680" Width="1200" Background="#111E2E"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="130" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{Binding RedFighter.RowBackground}" CornerRadius="4" Margin="0,0,0,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="160" />
                </Grid.ColumnDefinitions>

                <Grid Background="#DC143C">
                    <TextBlock Text="{Binding RedFighter.Points}" Foreground="White" FontSize="110" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,30"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,5">
                        <Button Content="+2" Focusable="False" Command="{Binding RedFighter.ModifyPointsCmd}" CommandParameter="2" Width="35" Height="30" Margin="1" FontWeight="Bold"/>
                        <Button Content="+3" Focusable="False" Command="{Binding RedFighter.ModifyPointsCmd}" CommandParameter="3" Width="35" Height="30" Margin="1" FontWeight="Bold"/>
                        <Button Content="+4" Focusable="False" Command="{Binding RedFighter.ModifyPointsCmd}" CommandParameter="4" Width="35" Height="30" Margin="1" FontWeight="Bold"/>
                        <Button Content="-1" Focusable="False" Command="{Binding RedFighter.ModifyPointsCmd}" CommandParameter="-1" Width="35" Height="30" Margin="1" FontWeight="Bold" Background="#7F0000" Foreground="White"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Column="1" Background="#EEEEEE" Margin="5,0">
                    <TextBlock Text="{Binding RedFighter.Advantages}" Foreground="Black" FontSize="65" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,25"/>
                    <TextBlock Text="Advantage" Foreground="#555" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,38"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,5">
                        <Button Content="+" Focusable="False" Command="{Binding RedFighter.ModifyAdvantagesCmd}" CommandParameter="1" Width="40" Height="30" Margin="2" FontWeight="Bold"/>
                        <Button Content="-" Focusable="False" Command="{Binding RedFighter.ModifyAdvantagesCmd}" CommandParameter="-1" Width="40" Height="30" Margin="2" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Column="2" Background="#FFCC00" Margin="0,0,5,0">
                    <TextBlock Text="{Binding RedFighter.Penalties}" Foreground="Black" FontSize="65" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,25"/>
                    <TextBlock Text="Penalty" Foreground="#222" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,38"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,5">
                        <Button Content="+" Focusable="False" Command="{Binding RedFighter.ModifyPenaltiesCmd}" CommandParameter="1" Width="40" Height="30" Margin="2" FontWeight="Bold"/>
                        <Button Content="-" Focusable="False" Command="{Binding RedFighter.ModifyPenaltiesCmd}" CommandParameter="-1" Width="40" Height="30" Margin="2" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="20,0,0,0">
                    <TextBox Text="{Binding RedFighter.Name, UpdateSourceTrigger=PropertyChanged}" 
                             KeyDown="TextBox_KeyDown"
                             Foreground="White" FontSize="56" FontWeight="Bold" 
                             Background="Transparent" BorderThickness="0" CaretBrush="White"/>
                    <ComboBox ItemsSource="{Binding Teams}" SelectedItem="{Binding RedFighter.Team}" Focusable="False"
                              Width="360" FontSize="26" HorizontalAlignment="Left" Margin="0,5,0,0" Background="#172637" Foreground="Black"/>
                </StackPanel>

                <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="10">
                    <Button Content="SUBMISSION" Focusable="False" Command="{Binding RedFighter.WinBySubCmd}" Background="#24A148" Foreground="White" FontWeight="Bold" Height="40" Margin="0,0,0,8"/>
                    <Button Content="DQ" Focusable="False" Command="{Binding RedFighter.WinByDqCmd}" Background="#DA1E28" Foreground="White" FontWeight="Bold" Height="40"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{Binding BlueFighter.RowBackground}" CornerRadius="4" Margin="0,5,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="160" />
                </Grid.ColumnDefinitions>

                <Grid Background="#0F62FE">
                    <TextBlock Text="{Binding BlueFighter.Points}" Foreground="White" FontSize="110" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,30"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,5">
                        <Button Content="+2" Focusable="False" Command="{Binding BlueFighter.ModifyPointsCmd}" CommandParameter="2" Width="35" Height="30" Margin="1" FontWeight="Bold"/>
                        <Button Content="+3" Focusable="False" Command="{Binding BlueFighter.ModifyPointsCmd}" CommandParameter="3" Width="35" Height="30" Margin="1" FontWeight="Bold"/>
                        <Button Content="+4" Focusable="False" Command="{Binding BlueFighter.ModifyPointsCmd}" CommandParameter="4" Width="35" Height="30" Margin="1" FontWeight="Bold"/>
                        <Button Content="-1" Focusable="False" Command="{Binding BlueFighter.ModifyPointsCmd}" CommandParameter="-1" Width="35" Height="30" Margin="1" FontWeight="Bold" Background="#002D9C" Foreground="White"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Column="1" Background="#EEEEEE" Margin="5,0">
                    <TextBlock Text="{Binding BlueFighter.Advantages}" Foreground="Black" FontSize="65" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,25"/>
                    <TextBlock Text="Advantage" Foreground="#555" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,38"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,5">
                        <Button Content="+" Focusable="False" Command="{Binding BlueFighter.ModifyAdvantagesCmd}" CommandParameter="1" Width="40" Height="30" Margin="2" FontWeight="Bold"/>
                        <Button Content="-" Focusable="False" Command="{Binding BlueFighter.ModifyAdvantagesCmd}" CommandParameter="-1" Width="40" Height="30" Margin="2" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Column="2" Background="#FFCC00" Margin="0,0,5,0">
                    <TextBlock Text="{Binding BlueFighter.Penalties}" Foreground="Black" FontSize="65" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,25"/>
                    <TextBlock Text="Penalty" Foreground="#222" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,38"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,5">
                        <Button Content="+" Focusable="False" Command="{Binding BlueFighter.ModifyPenaltiesCmd}" CommandParameter="1" Width="40" Height="30" Margin="2" FontWeight="Bold"/>
                        <Button Content="-" Focusable="False" Command="{Binding BlueFighter.ModifyPenaltiesCmd}" CommandParameter="-1" Width="40" Height="30" Margin="2" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="20,0,0,0">
                    <TextBox Text="{Binding BlueFighter.Name, UpdateSourceTrigger=PropertyChanged}" 
                             KeyDown="TextBox_KeyDown"
                             Foreground="White" FontSize="56" FontWeight="Bold" 
                             Background="Transparent" BorderThickness="0" CaretBrush="White"/>
                    <ComboBox ItemsSource="{Binding Teams}" SelectedItem="{Binding BlueFighter.Team}" Focusable="False"
                              Width="360" FontSize="26" HorizontalAlignment="Left" Margin="0,5,0,0" Background="#172637" Foreground="Black"/>
                </StackPanel>

                <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="10">
                    <Button Content="SUBMISSION" Focusable="False" Command="{Binding BlueFighter.WinBySubCmd}" Background="#24A148" Foreground="White" FontWeight="Bold" Height="40" Margin="0,0,0,8"/>
                    <Button Content="DQ" Focusable="False" Command="{Binding BlueFighter.WinByDqCmd}" Background="#DA1E28" Foreground="White" FontWeight="Bold" Height="40"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <ComboBox ItemsSource="{Binding Genders}" SelectedItem="{Binding SelectedGender}" 
                              FontSize="20" Width="150" Height="38" Margin="0,0,10,0"
                              VerticalContentAlignment="Center"/>

                    <TextBox Text="{Binding WeightInput, UpdateSourceTrigger=PropertyChanged}" 
                             KeyDown="TextBox_KeyDown" 
                             PreviewTextInput="WeightTextBox_PreviewTextInput" 
                             MaxLength="4"
                             Foreground="White" FontSize="24" FontWeight="Bold" 
                             Background="#172637" BorderBrush="#393939" Width="85" Height="38"
                             HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>

                    <TextBlock Text=" кг" Foreground="White" FontSize="22" VerticalAlignment="Center" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Сброс матча" Command="{Binding ResetCommand}" Focusable="False" Width="130" Height="38" Background="#393939" Foreground="White" FontWeight="Bold" FontSize="14"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,50,0">
                <TextBlock Text="Время боя (мин):" Foreground="#8A99AD" FontSize="14" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="-" Command="{Binding ModifyMatchDurationCmd}" CommandParameter="-1" Focusable="False" Width="35" Height="35" FontWeight="Bold" FontSize="18"/>
                    <TextBlock Text="{Binding MatchDurationMinutes}" Foreground="White" FontSize="24" Width="60" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                    <Button Content="+" Command="{Binding ModifyMatchDurationCmd}" CommandParameter="1" Focusable="False" Width="35" Height="35" FontWeight="Bold" FontSize="18"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Grid.Column="2" 
                       Text="{Binding TimeDisplay}" 
                       Foreground="{Binding TimerColor}" 
                       FontSize="120" 
                       FontWeight="Bold" 
                       VerticalAlignment="Center" 
                       HorizontalAlignment="Right" 
                       FontFamily="Consolas"
                       Margin="0,0,0,15"/>
        </Grid>
        <Popup x:Name="FullscreenNotification" Placement="Center" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="#CC000000" CornerRadius="8" Padding="20,12">
                <TextBlock Text="Нажмите F11 для выхода из полноэкранного режима" 
                           Foreground="White" FontSize="18" FontWeight="Bold"/>
            </Border>
        </Popup>
    </Grid>
</Window>